{
  "name": "game-journal",
  "version": "0.1.0",
  "private": true,
  "description": "Game journal desktop app",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:web": "node scripts/build-web.mjs",
    "vendor": "node --use-env-proxy scripts/vendor-dependencies.mjs",
    "desktop": "node electron/start.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "local.game-journal.app",
    "productName": "Game Journal",
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "ag-psd": "^30.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "parse5": "^8.0.1"
  }
}
